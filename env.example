# Environment Configuration Example
# Copy this file to create your own configuration

# Bocha API Key
# Get your API key from: https://bochaai.com
BOCHA_API_KEY=your-bocha-api-key-here

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=your-account-id

# Lambda Configuration
LAMBDA_FUNCTION_NAME=BochaWebSearchFunction
LAMBDA_ROLE_NAME=BochaLambdaExecutionRole

# Cognito Configuration (Generated by setup_cognito_s2s_bocha.sh)
# POOL_ID=us-west-2_xxxxxxxxx
# CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
# TOKEN_ENDPOINT=https://xxx.auth.us-west-2.amazoncognito.com/oauth2/token
# DISCOVERY_URL=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_xxxxxxxxx/.well-known/openid-configuration
